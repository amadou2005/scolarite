<%- include('partials/header') %>
<section class="auth">
  <h1>Créer mon compte étudiant</h1>
  <form method="post" action="/register" class="card auth-card" data-loading>
    <label>Numéro d’étudiant <input name="numero_etudiant" value="<%= form.numero_etudiant || '' %>" required autofocus></label>
    <div class="row2">
      <label>Nom <input name="nom" value="<%= form.nom || '' %>" required autocomplete="family-name"></label>
      <label>Prénom <input name="prenom" value="<%= form.prenom || '' %>" required autocomplete="given-name"></label>
    </div>
    <label>E-mail <input type="email" name="email" value="<%= form.email || '' %>" required autocomplete="email"></label>
    <div class="row2">
      <label>Filière
        <select name="filiere"><% filieres.forEach(f => { %><option <%= form.filiere === f ? 'selected' : '' %>><%= f %></option><% }) %></select>
      </label>
      <label>Niveau
        <select name="niveau"><% niveaux.forEach(n => { %><option <%= form.niveau === n ? 'selected' : '' %>><%= n %></option><% }) %></select>
      </label>
    </div>
    <label>Mot de passe (8 caractères minimum)
      <span class="pw">
        <input type="password" name="password" id="password" minlength="8" maxlength="72" required autocomplete="new-password" data-strength-input>
        <button type="button" class="link" data-toggle-password="password" aria-pressed="false">Afficher</button>
      </span>
      <span class="strength"><span data-strength-bar data-level="0"></span></span>
      <small class="muted" data-strength-label>&nbsp;</small>
    </label>
    <label>Confirmer le mot de passe
      <input type="password" name="password2" id="password2" minlength="8" maxlength="72" required autocomplete="new-password">
    </label>
    <button class="submit"><span class="label">Créer mon compte</span><i class="spinner"></i></button>
  </form>
  <p><a href="/login">J’ai déjà un compte</a></p>
</section>
<%- include('partials/footer') %>